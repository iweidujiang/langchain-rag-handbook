# === 大模型配置 ===
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# === 向量数据库（第 5 篇起需要）===
CHROMA_HOST=localhost
CHROMA_PORT=8000

# === 可选：本地模型 Ollama ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# === 可选：搜索工具（第 4 篇起需要）===
SERPAPI_API_KEY=
